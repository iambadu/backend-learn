# Copy this file to .env (in this same tutor/ directory) and fill in your key.
# .env is gitignored — it will never be committed.

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Any OpenRouter model slug works — see https://openrouter.ai/models
# for the current list of open-weight models and their exact slugs (these
# change often as new model versions ship, so check there if the default
# below ever returns a "model not found" error).
#
# Examples of open-weight families commonly available on OpenRouter:
#   meta-llama/llama-3.3-70b-instruct
#   qwen/qwen-2.5-72b-instruct
#   deepseek/deepseek-chat
#   mistralai/mistral-large
#
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
